{
  "name": "carebridge",
  "version": "1.2.0",
  "private": true,
  "description": "CareBridge: book doctor visits by voice in your own language and get rides from family without having to ask.",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "build:html": "python3 src/build.py",
    "dev": "node scripts/dev-server.mjs",
    "dev:mock": "MOCK=1 node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "vapid": "node scripts/gen-vapid.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  }
}
